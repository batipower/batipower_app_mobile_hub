# Copier ce fichier en `.env` puis ajuster. Seules les variables préfixées
# EXPO_PUBLIC_ sont exposées dans l'application (elles sont lisibles dans le
# bundle : ne jamais y mettre de secret).

# URL du back NestJS (routes /buyer-app/*), identique à API_BASE_URL du front externe.
# Pour viser un back local depuis l'iPhone, utiliser l'IP LAN du Mac
# (ex. http://192.168.1.20:3000) : `localhost` ne fonctionne pas depuis le téléphone.
EXPO_PUBLIC_API_BASE_URL=https://api-bati.batipower.fr

# URL du front externe web : pages « Mot de passe oublié » et « Demander un accès »
# ouvertes dans le navigateur intégré. Doit correspondre à EXTERNAL_APP_FRONT_URL
# du back (valeur par défaut du back : https://app.batipower.fr).
EXPO_PUBLIC_WEB_URL=https://app.batipower.fr
